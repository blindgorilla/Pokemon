# BUY OR PASS — environment variables
# Copy to `.env.local` for local development and set the real values in the
# Vercel project settings for preview/production. Never commit real secrets.

# --- Supabase (early-access signup storage) ---------------------------------
# Server-side only — never prefix these with NEXT_PUBLIC_ and never import
# lib/supabase.ts from a client component. The service_role key bypasses Row
# Level Security, so it must stay on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email / CRM provider (early-access list) -------------------------------
# Server-side only. The API route at app/api/early-access/route.ts activates the
# provider call when BOTH of these are present; without them it validates the
# payload and returns success so the form still works in preview.
EMAIL_PROVIDER_API_KEY=
EMAIL_PROVIDER_LIST_ID=
# Full endpoint URL of the provider's subscribe API (optional, provider-specific).
EMAIL_PROVIDER_ENDPOINT=

# --- Site ------------------------------------------------------------------
# Canonical origin used for metadata / Open Graph URLs (optional).
NEXT_PUBLIC_SITE_URL=
